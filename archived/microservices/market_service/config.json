{
  "service_name": "market_data_service",
  "version": "1.0",
  "port": 8001,
  "host": "0.0.0.0",
  "description": "Provides REST API for market data from Kite",
  "dependencies": [
    "kite_service"
  ],
  "endpoints": {
    "health": "/health",
    "market_data": "/api/market/<symbol>",
    "ltp": "/api/market/ltp/<symbol>",
    "ohlc": "/api/market/ohlc/<symbol>",
    "watchlist": "/api/market/watchlist"
  }
}
